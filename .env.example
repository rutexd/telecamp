# Telegram bot token (required, from @BotFather)
TELEGRAM_BOT_TOKEN=

# MTProto developer credentials (required, from https://my.telegram.org).
# Your own api_id/api_hash work for both user and bot accounts.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Path to the persisted MTProto session (created on first run).
TELEGRAM_SESSION_FILE=session.bin

# Where new releases are sent. Either:
#   TELEGRAM_CHANNEL: the channel @username (takes priority), or
#   TELEGRAM_CHAT_ID: a numeric chat id.
# Leave both empty to mark releases as seen without sending anywhere.
TELEGRAM_CHANNEL=
TELEGRAM_CHAT_ID=

# Directory holding the "already seen" cache
CACHE_DIRECTORY=cache

# Comma-separated tags to watch for new releases, e.g. electronic, ambient.
# Human text is normalized to Bandcamp slugs (lowercase, spaces -> hyphens,
# & -> and). Canonical slugs pass through ("rnb", "drum-and-bass").
#
# Values containing spaces/commas MUST be double-quoted for the .env parser.
# Examples (uncomment and edit to taste):
#   BANDCAMP_TAGS="electronic, ambient, synthwave, techno, drum-and-bass"
#   BANDCAMP_TAGS="post-rock, shoegaze, dream-pop, indie"
#   BANDCAMP_TAGS="dnb, dubstep, breakbeat"
BANDCAMP_TAGS=

# Comma-separated artist pages to watch, e.g. https://startrail.bandcamp.com
# Examples (uncomment and edit to taste):
#   BANDCAMP_ARTISTS="https://startrail.bandcamp.com, https://audioemissions.bandcamp.com"
BANDCAMP_ARTISTS=

# Comma-separated tags that mark an album as unwanted. If an album carries any
# of these tags it is skipped (marked as seen) without being downloaded/posted.
# Matching is case-insensitive and treats "-"/"_" as equal, so "sascha-müller"
# matches the page tag "sascha_müller".
#   BANDCAMP_TAG_BLACKLIST="demo, mixtape, dj-set"
BANDCAMP_TAG_BLACKLIST=

# Seconds between scan rounds
POLL_INTERVAL_SECONDS=3600
